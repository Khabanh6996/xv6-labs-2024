+uint64
+sys_trace(void)
+{
+  int mask;
+  
+  // Lấy đối số nguyên đầu tiên từ user space và gán vào mask
+  argint(0, &mask);
+  
+  // Lưu mask vào cấu trúc proc của tiến trình hiện tại
+  myproc()->trace_mask = mask;
+  
+  return 0;
+}
+
+uint64
+sys_procinfo(void)
+{
+  int pid;
+  uint64 info_addr; // Địa chỉ của struct procinfo ở không gian người dùng
+
+  // Lấy tham số 1 (pid) và tham số 2 (địa chỉ info) trực tiếp
+  argint(0, &pid);
+  argaddr(1, &info_addr);
+
+  // Gọi hàm tìm kiếm
+  return procinfo_get(pid, info_addr);
+}
