diff --git a/user/tree.c b/user/tree.c
new file mode 100644
index 0000000..bf777a7
--- /dev/null
+++ b/user/tree.c
@@ -0,0 +1,96 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/fs.h"
+#include "kernel/fcntl.h"
+#include "user/user.h"
+
+char*
+name_from_path(char *path)
+{
+  char *p;
+
+  for(p = path + strlen(path); p >= path && *p != '/'; p--)
+    ;
+  p++;
+
+  return p;
+}
+
+void
+tree(char *path, int depth)
+{
+  char buf[512], *p;
+  int fd;
+  struct dirent de;
+  struct stat st;
+
+  if((fd = open(path, O_RDONLY)) < 0){
+    fprintf(2, "tree: cannot open %s\n", path);
+    return;
+  }
+
+  if(fstat(fd, &st) < 0){
+    fprintf(2, "tree: cannot stat %s\n", path);
+    close(fd);
+    return;
+  }
+
+  // indentation
+  for(int i = 0; i < depth; i++)
+    printf("  ");
+
+  // print only name
+  char *name = name_from_path(path);
+  printf("%s", name);
+
+  if(st.type == T_DIR)
+    printf("/");
+
+  printf("\n");
+
+  if(st.type != T_DIR){
+    close(fd);
+    return;
+  }
+
+  if(strlen(path) + 1 + DIRSIZ + 1 > sizeof(buf)){
+    printf("tree: path too long\n");
+    close(fd);
+    return;
+  }
+
+  strcpy(buf, path);
+  p = buf + strlen(buf);
+  *p++ = '/';
+
+  while(read(fd, &de, sizeof(de)) == sizeof(de)){
+    if(de.inum == 0)
+      continue;
+
+    if(strcmp(de.name, ".") == 0 || strcmp(de.name, "..") == 0)
+      continue;
+
+    memmove(p, de.name, DIRSIZ);
+    p[DIRSIZ] = 0;
+
+    if(stat(buf, &st) < 0){
+      printf("tree: cannot stat %s\n", buf);
+      continue;
+    }
+
+    tree(buf, depth + 1);
+  }
+
+  close(fd);
+}
+
+int
+main(int argc, char *argv[])
+{
+  if(argc < 2)
+    tree(".", 0);
+  else
+    tree(argv[1], 0);
+
+  exit(0);
+}
